{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ozzyl-recipes",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "SITE_NAME": "Ozzyl Recipes",
    "PUBLIC_SITE_URL": "http://localhost:4321"
  },
  "observability": {
    "enabled": true
  }
}
