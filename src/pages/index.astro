---
import BaseLayout from "../layouts/BaseLayout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { listCategories, listRecipes } from "../lib/db";

const [featuredRecipes, latestRecipes, categories] = await Promise.all([
  listRecipes({ featured: true, limit: 3 }),
  listRecipes({ limit: 6 }),
  listCategories(10),
]);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Cook with confidence</p>
        <h1>Recipes made for <span>real life.</span></h1>
        <p class="hero-copy">
          Find dependable weeknight dinners, Bangladeshi favorites, quick ideas, and community-tested dishes with clear ingredients and directions.
        </p>
        <form class="search-box" action="/search" method="get">
          <input name="q" type="search" placeholder="Search chicken, pasta, tehari..." aria-label="Search recipes" required />
          <button class="button" type="submit">Search recipes</button>
        </form>
        <div class="chips" aria-label="Popular recipe categories">
          {categories.slice(0, 6).map((category) => (
            <a class="chip" href={`/search?q=${encodeURIComponent(category.name)}`}>{category.name}</a>
          ))}
        </div>
      </div>
      <div class="hero-art">
        <img
          src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1400&q=84"
          alt="A table filled with colorful home-cooked dishes"
          width="1000"
          height="1100"
        />
        <div class="hero-badge">
          <strong>Fresh ideas every week</strong>
          <span>Save recipes, rate dishes, and build your own cooking collection.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="feature-strip">
        <div class="feature-item"><strong>Clear directions</strong><span>Step-by-step cooking instructions without unnecessary confusion.</span></div>
        <div class="feature-item"><strong>Useful filters</strong><span>Browse by meal, ingredient, cuisine, occasion, diet, and cooking time.</span></div>
        <div class="feature-item"><strong>Community ratings</strong><span>Real feedback helps the most dependable recipes rise to the top.</span></div>
        <div class="feature-item"><strong>Fast everywhere</strong><span>Pages, APIs, media, and data run across Cloudflare's platform.</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2 class="section-title">Featured recipes</h2>
          <p class="section-copy">Reliable favorites selected for flavor, clarity, and repeatability.</p>
        </div>
        <a class="text-link" href="/search">Browse everything →</a>
      </div>

      {featuredRecipes.length > 0 ? (
        <div class="recipe-grid">
          {featuredRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
        </div>
      ) : (
        <div class="empty-state">Apply the included D1 migrations to load the starter recipes.</div>
      )}
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Recently published</p>
          <h2 class="section-title">What should we cook next?</h2>
        </div>
      </div>
      <div class="recipe-grid">
        {latestRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container callout">
      <div>
        <p class="eyebrow" style="color:#ffd46a">Built by home cooks</p>
        <h2 class="section-title">Share the recipe people always ask you for.</h2>
        <p>Publish ingredients, directions, timing, photos, and serving details from one simple editor.</p>
      </div>
      <div>
        <a class="button" href="/recipes/new">Add your first recipe</a>
      </div>
    </div>
  </section>
</BaseLayout>
