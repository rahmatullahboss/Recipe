---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CSRF_COOKIE,
  createCsrfToken,
  createRandomToken,
  getAuthReadiness,
  getCsrfCookieOptions,
  safeNextPath,
} from "../lib/auth";

if (Astro.locals.user) {
  return Astro.redirect("/account", 302);
}

const readiness = getAuthReadiness();
const next = safeNextPath(Astro.url.searchParams.get("next"));
const errorCode = Astro.url.searchParams.get("error") ?? "";
const errorMessages: Record<string, string> = {
  duplicate: "The account could not be created. Try signing in or use another email address.",
  invalid: "Review the email, display name, and password requirements and try again.",
  challenge: "The security challenge could not be verified. Please try again.",
  rate: "Too many registration attempts. Please wait before trying again.",
  request: "The registration request expired or was invalid. Please reload the page.",
  unavailable: "Account registration is not available until the required Cloudflare services and secrets are configured.",
};

let csrfToken = "";
if (readiness.ready) {
  let nonce = Astro.cookies.get(CSRF_COOKIE)?.value;
  if (!nonce) {
    nonce = createRandomToken(18);
    Astro.cookies.set(CSRF_COOKIE, nonce, getCsrfCookieOptions(Astro.request));
  }
  csrfToken = await createCsrfToken("register", nonce);
}
---

<BaseLayout
  title="Create Account — Ozzyl Recipes"
  description="Create a protected Ozzyl Recipes account."
  robots="noindex,nofollow"
>
  <section class="section">
    <div class="container auth-shell">
      <div class="auth-card">
        <p class="eyebrow">Member registration</p>
        <h1 class="section-title">Create your account</h1>
        <p class="section-copy">Passwords are protected with a unique salt, a server-only pepper, and PBKDF2-HMAC-SHA256. Publishing remains disabled until the email address is verified.</p>

        {errorMessages[errorCode] && (
          <div class="auth-alert auth-alert--error" role="alert">{errorMessages[errorCode]}</div>
        )}

        {!readiness.ready ? (
          <div class="auth-alert" role="status">
            <strong>Registration is safely disabled.</strong>
            <p>The form will open only after the following production dependencies are available:</p>
            <ul class="auth-missing">
              {readiness.missing.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ) : (
          <form class="auth-form" action="/api/auth/register" method="post">
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <input type="hidden" name="next" value={next} />

            <div class="auth-field">
              <label for="register-name">Display name</label>
              <input id="register-name" name="displayName" type="text" autocomplete="name" minlength="2" maxlength="80" required />
            </div>

            <div class="auth-field">
              <label for="register-email">Email address</label>
              <input id="register-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required />
            </div>

            <div class="auth-field">
              <label for="register-password">Password</label>
              <input id="register-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" aria-describedby="password-help" required />
              <span id="password-help" class="auth-help">Use 12–128 characters and do not include the username portion of your email address.</span>
            </div>

            <div class="turnstile-wrap">
              <div class="cf-turnstile" data-sitekey={readiness.siteKey} data-action="register" data-theme="light"></div>
            </div>

            <div class="auth-actions">
              <button class="button" type="submit">Create account</button>
              <a class="button button--ghost" href={`/login?next=${encodeURIComponent(next)}`}>Already registered</a>
            </div>
          </form>
        )}
      </div>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>
