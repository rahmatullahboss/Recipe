---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Ozzyl Recipes" description="About the Ozzyl Recipes cooking platform.">
  <section class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Our purpose</p>
      <h1 class="section-title">Dependable recipes for everyday cooks.</h1>
      <p class="section-copy">Ozzyl Recipes is an original recipe discovery and publishing platform focused on clear instructions, useful filtering, community feedback, and a strong collection of Bangladeshi and international food.</p>
      <p class="section-copy">The platform is built end-to-end on Cloudflare Workers and related Cloudflare services for fast delivery, simple operations, and room to grow.</p>
    </div>
  </section>
</BaseLayout>
