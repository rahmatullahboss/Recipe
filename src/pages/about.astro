---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Ozzyl Recipes" description="About the international Ozzyl Recipes cooking platform.">
  <section class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Our purpose</p>
      <h1 class="section-title">Dependable recipes, relevant wherever you cook.</h1>
      <p class="section-copy">Ozzyl Recipes is an original international recipe discovery and publishing platform focused initially on audiences in the United States, Canada, Europe, Australia, and New Zealand.</p>
      <p class="section-copy">Recipes are organised by country, cuisine, language, ingredients, diet, occasion, and cooking style. Cloudflare location signals help prioritise the visitor's market, while a manual selector keeps the entire global catalogue accessible.</p>
      <p class="section-copy">The platform is built end-to-end on Cloudflare Workers and related Cloudflare services for fast delivery, simple operations, and room to grow.</p>
    </div>
  </section>
</BaseLayout>
