---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CSRF_COOKIE,
  createCsrfToken,
  createRandomToken,
  getAuthReadiness,
  getCsrfCookieOptions,
} from "../lib/auth";

const readiness = getAuthReadiness();
const token = Astro.url.searchParams.get("token")?.trim() ?? "";
const error = Astro.url.searchParams.get("error") ?? "";
const messages: Record<string, string> = {
  request: "The confirmation request expired. Open the verification link again.",
  invalid: "This verification link is invalid, expired, or has already been used.",
  unavailable: "Email verification is temporarily unavailable.",
};

let csrfToken = "";
if (readiness.passwordPepper) {
  let nonce = Astro.cookies.get(CSRF_COOKIE)?.value;
  if (!nonce) {
    nonce = createRandomToken(18);
    Astro.cookies.set(CSRF_COOKIE, nonce, getCsrfCookieOptions(Astro.request));
  }
  csrfToken = await createCsrfToken("verify-email", nonce);
}
---

<BaseLayout
  title="Verify Email — Ozzyl Recipes"
  description="Confirm an Ozzyl Recipes account email address."
  robots="noindex,nofollow"
>
  <section class="section">
    <div class="container auth-shell">
      <div class="auth-card">
        <p class="eyebrow">Email verification</p>
        <h1 class="section-title">Confirm your email</h1>
        <p class="section-copy">Verification links are single-use and expire after 30 minutes. The token is stored only as a SHA-256 digest.</p>

        {messages[error] && <div class="auth-alert auth-alert--error" role="alert">{messages[error]}</div>}

        {token && readiness.database && readiness.sessions && readiness.passwordPepper ? (
          <form class="auth-form" action="/api/auth/verify-email" method="post">
            <input type="hidden" name="token" value={token} />
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <div class="auth-actions">
              <button class="button" type="submit">Verify email address</button>
              <a class="button button--ghost" href="/account">Return to account</a>
            </div>
          </form>
        ) : (
          <div class="auth-alert" role="status">
            <strong>No usable verification token was found.</strong>
            <p>Open the complete link from the verification email. Outbound email delivery must also be configured before links can be issued automatically.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
