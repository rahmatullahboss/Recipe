---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sign In — Ozzyl Recipes"
  description="Sign in to save and publish recipes."
  robots="noindex,nofollow"
>
  <section class="section">
    <div class="container" style="max-width:680px">
      <div class="recipe-panel">
        <p class="eyebrow">Member accounts</p>
        <h1 class="section-title">Sign in</h1>
        <p class="section-copy">Browser-saved recipes already work without an account. Secure sessions, email verification, Turnstile validation, and cross-device collection sync will be connected in the authentication phase.</p>
        <div class="filter-actions">
          <a class="button" href="/saved">View saved recipes</a>
          <a class="button button--ghost" href="/">Continue browsing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
