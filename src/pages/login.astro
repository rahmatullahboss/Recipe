---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Sign In — Ozzyl Recipes" description="Sign in to save and publish recipes.">
  <section class="section">
    <div class="container" style="max-width:680px">
      <div class="recipe-panel">
        <p class="eyebrow">Member accounts</p>
        <h1 class="section-title">Sign in</h1>
        <p class="section-copy">The account interface is reserved in this foundation. Secure sessions, email verification, password hashing, and Turnstile validation are the next implementation phase.</p>
        <div style="margin-top:28px">
          <a class="button" href="/">Continue browsing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
