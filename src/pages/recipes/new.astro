---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Add a Recipe — Ozzyl Recipes" description="Publish a recipe for the Ozzyl Recipes community.">
  <section class="section">
    <div class="container" style="max-width:760px">
      <div class="recipe-panel">
        <p class="eyebrow">Community publishing</p>
        <h1 class="section-title">Add your recipe</h1>
        <p class="section-copy">The publishing route is ready. The next phase connects this screen to authenticated drafts, ingredient and direction editors, moderation, Turnstile, and signed R2 image uploads.</p>
        <div style="margin-top:28px">
          <a class="button" href="/search">Explore published recipes</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
