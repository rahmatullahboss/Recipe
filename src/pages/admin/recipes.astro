---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getRecipeSubmissionReadiness, listEditorialQueue } from "../../lib/recipe-submissions";

if (!Astro.locals.user || !Astro.locals.session) {
  return Astro.redirect("/login?next=%2Fadmin%2Frecipes", 302);
}
const editorial = Astro.locals.user.role === "editor" || Astro.locals.user.role === "admin";
if (!editorial) Astro.response.status = 403;
const readiness = getRecipeSubmissionReadiness();
const queue = editorial && readiness.database ? await listEditorialQueue(100) : [];
---

<BaseLayout title="Recipe Editorial Queue — Ozzyl Recipes" description="Review private contributor recipe submissions." robots="noindex,nofollow">
  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Editorial operations</p>
      <h1 class="section-title">Recipe review queue</h1>
      <p class="section-copy">Publication remains separate from media approval. Every recipe must have complete content and an approved hero image.</p>
    </div>
  </section>
  <section class="section">
    <div class="container moderation-shell">
      {!editorial ? (
        <div class="auth-alert auth-alert--error"><strong>Editorial permission required.</strong></div>
      ) : !readiness.database ? (
        <div class="auth-alert"><strong>D1 editorial storage is unavailable.</strong></div>
      ) : queue.length === 0 ? (
        <div class="moderation-empty"><h2>No recipes awaiting review</h2><p>The editorial queue is clear.</p></div>
      ) : (
        <div class="submission-list">
          {queue.map((item: any) => (
            <article class="submission-card">
              <p class="eyebrow">{item.country_code} · {item.language_code}</p>
              <h2>{item.title}</h2>
              <p>{item.summary}</p>
              <p class="submission-card__meta">By {item.author_name} · image {item.media_moderation_status || "missing"} · {item.ingredient_count} ingredients · {item.step_count} steps</p>
              <a class="button" href={`/admin/recipes/${item.id}`}>Review submission</a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
