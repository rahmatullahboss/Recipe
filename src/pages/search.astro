---
import BaseLayout from "../layouts/BaseLayout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { listRecipes } from "../lib/db";
import { resolveMarket } from "../lib/market";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const market = resolveMarket(Astro.request, Astro.url);
const recipes = await listRecipes({ search: query || undefined, country: market.code, limit: 30 });
const title = query ? `Search results for “${query}” — Ozzyl Recipes` : "Browse International Recipes — Ozzyl Recipes";
---

<BaseLayout title={title} description={`Search international recipes with results prioritised for ${market.name}.`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Recipe finder · {market.name}</p>
      <h1 class="section-title">{query ? `Results for “${query}”` : "Browse international recipes"}</h1>
      <p class="section-copy">Recipes from your selected market appear first, followed by relevant dishes from the wider catalogue.</p>
      <form class="search-box" action="/search" method="get">
        <input name="q" type="search" value={query} placeholder="Search recipes, ingredients, or cuisines..." aria-label="Search recipes" />
        <button class="button" type="submit">Search</button>
      </form>

      <div style="margin-top:42px">
        {recipes.length > 0 ? (
          <div class="recipe-grid">
            {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No recipes found</h2>
            <p>Try a broader ingredient, cuisine, or meal name.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
